{
  "name": "julang-platform",
  "version": "7.2.0",
  "private": true,
  "description": "劇浪 JuLang — 短劇平台 API（v7.2）。這個 package.json 是事後補回的：repo 只附了 package-lock.json，缺它 npm 完全無法安裝。依賴清單逐字取自 lockfile 的 packages[\"\"] 根節點，所以 npm ci / npm install 與鎖檔一致。",
  "main": "api/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node api/server.js",
    "dev": "nodemon api/server.js",
    "test": "jest",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:ddl": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "redis": "^4.6.14",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "prisma": "^5.15.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
