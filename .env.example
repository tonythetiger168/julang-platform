# ===== 基礎配置 =====
DATABASE_URL=postgresql://user:password@localhost:5432/julang?schema=public
JWT_SECRET=julang-2026-secret-key-change-me
PORT=3001
FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379

# ===== v6.2 文件存儲配置 =====
# 存儲提供商：local（本地磁盤）/ oss（阿里云）/ s3（AWS/兼容）
STORAGE_PROVIDER=local
UPLOAD_BASE_URL=

# 阿里云 OSS（STORAGE_PROVIDER=oss 時必填）
# OSS_REGION=oss-cn-hangzhou
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=julang-assets
# OSS_CDN_URL=https://cdn.example.com

# AWS S3 / 兼容（STORAGE_PROVIDER=s3 時必填）
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=julang-assets
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_CDN_URL=https://cdn.example.com

# ===== v5.0 AI 漫劇生成（均可選，留空自動降級） =====
# 劇本生成：任意 OpenAI 兼容 Chat 接口（Moonshot/Kimi、OpenAI、DeepSeek...）
AI_LLM_API_KEY=
AI_LLM_BASE_URL=https://api.moonshot.cn/v1
AI_LLM_MODEL=moonshot-v1-8k

# 分鏡圖生成：OpenAI 兼容 Images 接口
AI_IMAGE_API_KEY=
AI_IMAGE_BASE_URL=https://api.openai.com/v1
AI_IMAGE_MODEL=dall-e-3
AI_IMAGE_SIZE=1024x1792

# 配音合成：OpenAI 兼容 Speech 接口
AI_TTS_API_KEY=
AI_TTS_BASE_URL=https://api.openai.com/v1
AI_TTS_MODEL=tts-1
